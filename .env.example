# copiar a .env para correr fuera de docker; en el sistema completo las setea pdf-extractext-deploy
SERVICE_NAME=pdf-extract-service
SERVICE_VERSION=1.0.0
LOG_LEVEL=INFO
GRANIAN_PORT=8000
MAX_PDF_SIZE_MB=10

# procesos que extraen en paralelo y maximo de extracciones aceptadas a la vez
EXTRACT_WORKERS=1
MAX_IN_FLIGHT=8
SATURATED_RETRY_AFTER_SECONDS=2

CONSUL_ENABLED=false
CONSUL_URL=http://consul:8500
CONSUL_TOKEN=
SERVICE_ADDRESS=
HEALTH_CHECK_INTERVAL=10s

ROUTER_NAME=extract
PUBLIC_HOST=extract.pdfextractext.localhost
INTERNAL_HOST=extract.internal
RETRY_ATTEMPTS=3
RETRY_INITIAL_INTERVAL=100ms
